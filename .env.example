DB_USER=board
# Generate with `openssl rand -hex 24` and place into .env (not version control).
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DB_PORT=5432
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# Canonical Team Canvas browser origin (no trailing slash); use this exact URL on every device.
PUBLIC_ORIGIN=http://localhost:8088
# Development Keycloak has its own browser URL and host port (URL has no trailing slash).
KEYCLOAK_BIND=127.0.0.1
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180/auth
# Development-only Keycloak credentials. Change before sharing over your WLAN.
DEV_ALICE_PASSWORD=alice-dev-only
DEV_BOB_PASSWORD=bob-dev-only
DEV_OIDC_CLIENT_SECRET=development-only-client-secret
DEV_OIDC_SESSION_SECRET=development-only-session-encryption-secret-change-me
DEV_ADMIN_PASSWORD=admin-dev-only
