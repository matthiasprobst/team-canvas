{
  "name": "team-canvas-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "predev": "node scripts/copy-fonts.mjs",
    "prebuild": "node scripts/copy-fonts.mjs",
    "test:sync": "tsc --target es2022 --module commonjs --moduleResolution node --skipLibCheck --outDir ../.test-build src/protocol.ts src/protocolCodec.ts src/syncCore.ts src/syncSession.ts && node --test ../tests/*.test.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
