{
  "realm": "team-canvas",
  "enabled": true,
  "displayName": "Team Canvas development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "team-canvas",
      "name": "Team Canvas",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DEV_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${PUBLIC_ORIGIN}/api/login"
      ],
      "webOrigins": [
        "${PUBLIC_ORIGIN}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PUBLIC_ORIGIN}/login",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "team-canvas-mcp",
      "name": "Team Canvas external assistants",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["basic", "profile", "email", "canvas:read", "canvas:propose"],
      "protocolMappers": [{
        "name": "team-canvas-mcp-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "config": {"included.custom.audience": "${PUBLIC_ORIGIN}/mcp", "access.token.claim": "true", "id.token.claim": "false"}
      }]
    }
  ],
  "clientScopes": [
    {"name":"basic","protocol":"openid-connect","attributes":{"include.in.token.scope":"false"},"protocolMappers":[
      {"name":"sub","protocol":"openid-connect","protocolMapper":"oidc-sub-mapper","config":{"access.token.claim":"true","introspection.token.claim":"true"}}
    ]},
    {"name":"profile","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"},"protocolMappers":[
      {"name":"username","protocol":"openid-connect","protocolMapper":"oidc-usermodel-property-mapper","config":{"user.attribute":"username","claim.name":"preferred_username","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true","userinfo.token.claim":"true"}},
      {"name":"full name","protocol":"openid-connect","protocolMapper":"oidc-full-name-mapper","config":{"access.token.claim":"true","id.token.claim":"true","userinfo.token.claim":"true"}}
    ]},
    {"name":"email","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"},"protocolMappers":[
      {"name":"email","protocol":"openid-connect","protocolMapper":"oidc-usermodel-property-mapper","config":{"user.attribute":"email","claim.name":"email","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true","userinfo.token.claim":"true"}}
    ]},
    {"name":"roles","protocol":"openid-connect","attributes":{"include.in.token.scope":"false"},"protocolMappers":[
      {"name":"client roles","protocol":"openid-connect","protocolMapper":"oidc-usermodel-client-role-mapper","config":{"claim.name":"resource_access.${client_id}.roles","jsonType.label":"String","multivalued":"true","access.token.claim":"true","id.token.claim":"false","userinfo.token.claim":"false"}}
    ]},
    {"name":"canvas:read","protocol":"openid-connect","attributes":{"include.in.token.scope":"true","display.on.consent.screen":"true","consent.screen.text":"Read your shared Team Canvas content"}},
    {"name":"canvas:propose","protocol":"openid-connect","attributes":{"include.in.token.scope":"true","display.on.consent.screen":"true","consent.screen.text":"Propose changes to your canvases"}}
  ],
  "users": [
    {
      "id": "cc5a3ab8-92e0-4ef9-b39d-111111111111",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Morgan",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_ALICE_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "team-canvas": [
          "team-canvas-admin"
        ]
      }
    },
    {
      "id": "cc5a3ab8-92e0-4ef9-b39d-222222222222",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Taylor",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_BOB_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.test",
      "firstName": "Carol",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "carol-dev-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "email": "dave@example.test",
      "firstName": "Dave",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "dave-dev-only",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "team-canvas": [
        {
          "name": "team-canvas-admin",
          "description": "Manage application account lifecycle"
        }
      ]
    }
  }
}
