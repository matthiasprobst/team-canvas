{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecret",
    "migrationSecret",
    "host",
    "tlsSecret",
    "ingressClassName",
    "trustedProxies",
    "databaseCIDR",
    "identityCIDR",
    "images",
    "limits"
  ],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "migrationSecret": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]+$"
    },
    "tlsSecret": {
      "type": "string",
      "minLength": 1
    },
    "ingressClassName": {
      "type": "string",
      "minLength": 1
    },
    "trustedProxies": {
      "type": "string",
      "minLength": 1
    },
    "databaseCIDR": {
      "type": "string",
      "minLength": 1
    },
    "identityCIDR": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "object",
      "required": [
        "backend",
        "frontend"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "frontend": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxConnectionsPerCanvas",
        "maxPagesPerCanvas",
        "maxOwnedCanvasesPerUser"
      ],
      "additionalProperties": false,
      "properties": {
        "maxConnectionsPerCanvas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxPagesPerCanvas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxOwnedCanvasesPerUser": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespaceLabels",
        "podLabels"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "namespaceLabels": {
                "minProperties": 1
              },
              "podLabels": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    }
  }
}
