:80 {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  handle /auth/* {
    respond 404
  }
  @backend path /api/* /ws/*
  handle @backend {
    header Cache-Control no-store
    reverse_proxy backend:8080 {
      header_up X-Forwarded-Host {hostport}
    }
  }
  handle {
    header X-Frame-Options DENY
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
